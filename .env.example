# HR & Payroll Management System - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=3600

# ============================================
# Database Configuration
# ============================================
# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_PASSWORD=admin

# ============================================
# Cache Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Message Broker Configuration
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

# ============================================
# Email/SMTP Configuration
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@hrpayroll.com
SMTP_FROM_NAME=HR Payroll System

# ============================================
# API Gateway Configuration
# ============================================
API_GATEWAY_URL=http://api-gateway:8000
KONG_ADMIN_URL=http://api-gateway:8001

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=HR & Payroll Management System
VITE_APP_VERSION=1.0.0

# ============================================
# Monitoring Configuration
# ============================================
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Elasticsearch
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Kibana
KIBANA_PORT=5601

# ============================================
# Service Ports
# ============================================
EMPLOYEE_SERVICE_PORT=8101
PAYROLL_SERVICE_PORT=8102
TIME_ATTENDANCE_SERVICE_PORT=8103
USER_SERVICE_PORT=8104
NOTIFICATION_SERVICE_PORT=8105
BENEFITS_SERVICE_PORT=8106
TAX_SERVICE_PORT=8107
PERFORMANCE_SERVICE_PORT=8108
RECRUITMENT_SERVICE_PORT=8109
REPORTING_SERVICE_PORT=8110

# ============================================
# Application Configuration
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_LOCALE=en

# ============================================
# Security Configuration
# ============================================
# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Tenant-ID

# Session
SESSION_LIFETIME=120
SESSION_DRIVER=redis

# ============================================
# File Storage Configuration
# ============================================
STORAGE_DRIVER=local
STORAGE_PATH=/var/www/storage

# AWS S3 (if using cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=debug
LOG_CHANNEL=stack

# ============================================
# Multi-tenancy Configuration
# ============================================
MULTI_TENANT_ENABLED=true
DEFAULT_TENANT_ID=default

# ============================================
# Payment Gateway Configuration (Optional)
# ============================================
STRIPE_KEY=
STRIPE_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# ============================================
# SMS Configuration (Optional)
# ============================================
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_NUMBER=

# ============================================
# Push Notification Configuration (Optional)
# ============================================
FIREBASE_SERVER_KEY=
FIREBASE_PROJECT_ID=

# ============================================
# Backup Configuration
# ============================================
BACKUP_ENABLED=true
BACKUP_PATH=/backups
BACKUP_RETENTION_DAYS=30

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# ============================================
# Feature Flags
# ============================================
FEATURE_PERFORMANCE_REVIEWS=true
FEATURE_RECRUITMENT=true
FEATURE_BENEFITS=true
FEATURE_TAX_COMPLIANCE=true
FEATURE_REPORTING=true

# ============================================
# External API Keys (Optional)
# ============================================
GOOGLE_MAPS_API_KEY=
LINKEDIN_API_KEY=
INDEED_API_KEY=

# ============================================
# Development/Testing
# ============================================
SEED_DATABASE=false
ENABLE_QUERY_LOG=false
ENABLE_PROFILING=false
