{
  "name": "hrpayroll/notification-service",
  "description": "Notification Microservice",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "symfony/http-foundation": "^6.4",
    "symfony/routing": "^6.4",
    "symfony/validator": "^6.4",
    "symfony/mailer": "^6.4",
    "ramsey/uuid": "^4.7",
    "monolog/monolog": "^3.5",
    "php-amqplib/php-amqplib": "^3.5",
    "mongodb/mongodb": "^1.17",
    "predis/predis": "^2.2",
    "twilio/sdk": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "HRPayroll\\Notification\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HRPayroll\\Notification\\Tests\\": "tests/"
    }
  }
}
