{
  "name": "hrpayroll/tax-compliance-service",
  "description": "Tax & Compliance Management Microservice",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "symfony/http-foundation": "^6.4",
    "symfony/routing": "^6.4",
    "symfony/validator": "^6.4",
    "doctrine/orm": "^2.17",
    "doctrine/dbal": "^3.7",
    "ramsey/uuid": "^4.7",
    "monolog/monolog": "^3.5",
    "php-amqplib/php-amqplib": "^3.5",
    "mongodb/mongodb": "^1.17"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "HRPayroll\\TaxCompliance\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HRPayroll\\TaxCompliance\\Tests\\": "tests/"
    }
  }
}
