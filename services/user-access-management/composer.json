{
  "name": "hrpayroll/user-access-management-service",
  "description": "User Access Management & Authentication Microservice",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "symfony/http-foundation": "^6.4",
    "symfony/routing": "^6.4",
    "symfony/validator": "^6.4",
    "doctrine/orm": "^2.17",
    "doctrine/dbal": "^3.7",
    "firebase/php-jwt": "^6.10",
    "ramsey/uuid": "^4.7",
    "monolog/monolog": "^3.5",
    "predis/predis": "^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "HRPayroll\\UserAccessManagement\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HRPayroll\\UserAccessManagement\\Tests\\": "tests/"
    }
  }
}
